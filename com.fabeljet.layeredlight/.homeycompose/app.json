{
  "id": "com.fabeljet.layeredlight",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Layered light"
  },
  "description": {
    "en": "Layer light scenes"
  },
  "category": [
    "lights"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Jørgen Seland",
    "email": "jorgen@fabeljet.com"
  },
  "settings": [],
  "api": {
    "getDevices":   { "method": "GET",  "path": "/devices"   },
    "getVariables": { "method": "GET",  "path": "/variables" },
    "postVariable": { "method": "POST", "path": "/variable"  },
    "postPreview":  { "method": "POST", "path": "/preview"   }
  }
}